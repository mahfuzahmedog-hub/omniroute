# Forge backend configuration. Copy to `.env` and edit before running.
# All variables are prefixed with FORGE_ and are read by forge.config.Settings.

# Environment: "local" | "development" | "staging" | "production"
FORGE_ENVIRONMENT=local

# REQUIRED in non-local environments: a long, random secret used to sign JWTs.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FORGE_SECRET_KEY=dev-only-insecure-secret-change-me

# Database URL (SQLAlchemy format).
#   SQLite (default, zero-config):   sqlite+pysqlite:///./forge.db
#   Postgres (docker compose):       postgresql+psycopg://forge:forge@localhost:5432/forge
FORGE_DATABASE_URL=sqlite+pysqlite:///./forge.db

# Access-token lifetime in minutes.
FORGE_ACCESS_TOKEN_TTL_MINUTES=60

# Comma-separated list of allowed CORS origins for the browser UI.
FORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log level: DEBUG | INFO | WARNING | ERROR
FORGE_LOG_LEVEL=INFO
